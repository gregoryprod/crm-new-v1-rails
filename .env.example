# Скопируй в .env (он игнорируется Git) и заполни. Здесь нет секретов.
# Rails читает .env только в development и test; на сервере переменные задаёт Kamal.

# --- База ---
# postgresql://<user>:<password>@127.0.0.1:5432/vpc_crm_development
DATABASE_URL=
# Отдельная тестовая база: тесты её очищают. Никогда не указывай рабочую.
TEST_DATABASE_URL=

# --- Приложение ---
# Публичный origin без пути. http разрешён только для localhost/127.0.0.1;
# для https cookie получает Secure и префикс __Host-.
APP_ORIGIN=http://127.0.0.1:3200
# Не короче 32 символов: bin/rails secret | cut -c1-48. Не менять после запуска.
AUTH_SECRET=
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=50
LOGIN_WINDOW_MINUTES=15
# true только за доверенным прокси, который перезаписывает X-Forwarded-For (kamal-proxy — да).
TRUST_PROXY=false
CRM_TIME_ZONE=Europe/Moscow

# --- Приём заявок из квиза (POST /api/leads) ---
# Без этих трёх значений приём отвечает 503, остальное приложение работает.
LEADS_ALLOWED_ORIGINS=
CONSENT_PD_VERSION=
CONSENT_MARKETING_VERSION=
LEADS_IP_MAX_PER_WINDOW=10
LEADS_GLOBAL_MAX_PER_WINDOW=300
LEADS_WINDOW_MINUTES=60

# --- Воркер уведомлений (bin/rails notifications:work) ---
# Живая отправка — только в разрешённый тестовый чат.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10
WORKER_POLL_SECONDS=5

# --- Только для bin/rails crm:seed_owner ---
OWNER_EMAIL=
OWNER_NAME=
# Не короче 12 символов, словарные пароли отклоняются.
OWNER_PASSWORD=
