<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "CRM VetPetCare" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "brand-tokens", "application" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body>
    <% if flash[:notice] %><p class="success flash" role="status"><%= flash[:notice] %></p><% end %>
    <% if flash[:alert] %><p class="error flash" role="alert"><%= flash[:alert] %></p><% end %>
    <%= yield %>
  </body>
</html>
